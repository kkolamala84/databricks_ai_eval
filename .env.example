# =============================================================================
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is loaded automatically by config/settings.py via python-dotenv, and
# is excluded from git via .gitignore -- never commit real secrets.
#
# This is the quick-start version (required vars only). For a fully
# documented reference of every variable the framework reads (including
# optional overrides), see .env.template.example.
# =============================================================================

# ---- Required: Databricks workspace auth -----------------------------------
# Used to call the agent serving endpoint (eval/agent_client.py) and, for
# local runs, to reach Databricks-hosted LLM judges + Unity Catalog.
# Create a personal access token under Databricks > Settings > Developer >
# Access tokens, or use a service-principal token for CI/automation.
DATABRICKS_HOST=https://dbc-08ff8153-2dcb.cloud.databricks.com
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Required for local runs that sync results to Unity Catalog -----------
# (eval/uc_sync.py, uc/setup_uc.py). Find it in Databricks under
# SQL Warehouses > <warehouse name> > Connection details > HTTP path.
# Only the numeric/alphanumeric warehouse id, not the full path.
DATABRICKS_SQL_WAREHOUSE_ID=

# ---- Optional overrides -----------------------------------------------------
# Unity Catalog location for eval metrics tables (defaults come from
# config/eval_config.yaml: krishna.agent_eval).
# EVAL_UC_CATALOG=krishna
# EVAL_UC_SCHEMA=agent_eval

# Model that powers all LLM judges/scorers (default: "databricks", i.e. the
# Databricks-hosted managed judge model -- works for both local and
# Databricks runs as long as DATABRICKS_HOST/TOKEN above are set).
# MLFLOW_JUDGE_MODEL=databricks

# Local MLflow tracking store (default: sqlite:///mlflow.db in the project
# root -- see config/eval_config.yaml -> mlflow.local.tracking_uri).
# MLFLOW_LOCAL_TRACKING_URI=sqlite:///mlflow.db

# Experiments are created per agent at /Shared/<agent_name>.
# No environment variable is needed to select the experiment path.
