# =============================================================================
# Environment variable template & reference for databricks_ai_eval
# =============================================================================
# This file documents every environment variable the framework reads, why
# it's needed, and where it's used. To actually run anything:
#   1. Copy this file to `.env` in this same directory:
#        cp .env.template.example .env
#   2. Fill in the values below (at minimum: DATABRICKS_HOST, DATABRICKS_TOKEN).
#   3. Never commit `.env` -- it's already excluded via .gitignore.
#
# `.env` is loaded automatically by config/settings.py (via python-dotenv) at
# import time, for BOTH local and Databricks execution. On Databricks, you
# can alternatively rely on the notebook/job's own auth context instead of a
# `.env` file -- see docs/RUNBOOK.md "Running on Databricks".
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED -- Databricks workspace authentication
# -----------------------------------------------------------------------------

# Workspace URL (no trailing slash). Used to:
#   - build the agent serving endpoint URL when config/agents.yaml doesn't
#     hardcode one (config/settings.py: AgentConfig.resolved_endpoint_url)
#   - derive the SQL warehouse hostname for local Unity Catalog writes
#     (eval/uc_sync.py, uc/setup_uc.py, uc/seed_agent_registry.py)
# Example: https://dbc-08ff8153-2dcb.cloud.databricks.com
DATABRICKS_HOST=https://dbc-08ff8153-2dcb.cloud.databricks.com

# Personal access token (or service-principal/OAuth token for CI) with:
#   - CAN QUERY permission on the vacation_planner_agent serving endpoint
#   - CREATE TABLE on the target Unity Catalog schema (krishna.agent_eval)
#   - access to a SQL warehouse (for local UC writes)
# Create one under Databricks > Settings > Developer > Access tokens.
# Used by: eval/agent_client.py (calls the agent endpoint), eval/uc_sync.py
# and uc/*.py (Unity Catalog writes), and indirectly by MLflow's Databricks
# auth integration when MLFLOW_TRACKING_URI="databricks".
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# REQUIRED FOR LOCAL RUNS THAT SYNC TO UNITY CATALOG (--sync-uc)
# -----------------------------------------------------------------------------

# SQL warehouse id used to execute DDL/INSERT statements against Unity
# Catalog from a local machine (no Spark session available locally).
# Find it in Databricks under SQL Warehouses > <warehouse> > Connection
# details > "HTTP path" -- the id is the last path segment, e.g. for
# ".../sql/1.0/warehouses/abc123def456" the id is "abc123def456".
# Used by: eval/uc_sync.py, uc/setup_uc.py, uc/seed_agent_registry.py
# Not required when running inside a Databricks notebook/job (a Spark
# session is used instead, see uc/setup_uc.py:in_databricks_runtime()).
DATABRICKS_SQL_WAREHOUSE_ID=


# -----------------------------------------------------------------------------
# OPTIONAL -- Unity Catalog location override
# -----------------------------------------------------------------------------
# Defaults come from config/eval_config.yaml (unity_catalog.catalog / .schema
# -- currently krishna / agent_eval). Override here if you want a different
# catalog/schema without editing the YAML (e.g. a "krishna_dev" sandbox
# catalog for local experimentation).
# Used by: config/settings.py (UnityCatalogConfig)
# EVAL_UC_CATALOG=krishna
# EVAL_UC_SCHEMA=agent_eval


# -----------------------------------------------------------------------------
# OPTIONAL -- LLM judge model override
# -----------------------------------------------------------------------------
# Model URI that powers every scorer/judge (Safety, Correctness,
# RelevanceToQuery, Guidelines, tool_usage_validator). Default: "databricks"
# (the Databricks-hosted managed judge model). Pinning this explicitly keeps
# judge behavior identical between local (sqlite tracking URI) and
# Databricks (databricks tracking URI) runs -- otherwise MLflow silently
# falls back to "openai:/gpt-4.1-mini" for any non-Databricks tracking URI,
# which would require OPENAI_API_KEY and behave differently.
# Other valid formats: "databricks:/databricks-gpt-5-mini", "openai:/gpt-4o",
# "anthropic:/claude-...", "gemini:/gemini-2.5-flash".
# Used by: config/settings.py (Settings.judge_model), scorers/judges.py
# MLFLOW_JUDGE_MODEL=databricks


# -----------------------------------------------------------------------------
# OPTIONAL -- MLflow tracking store override (local runs only)
# -----------------------------------------------------------------------------
# Where local evaluation runs log traces/metrics. Default:
# sqlite:///mlflow.db in the project root (config/eval_config.yaml ->
# mlflow.local.tracking_uri). Point this at a different SQLite file, or a
# shared Postgres/MySQL MLflow tracking server URI, if desired.
# Used by: config/settings.py (Settings.mlflow_local)
# MLFLOW_LOCAL_TRACKING_URI=sqlite:///mlflow.db


# -----------------------------------------------------------------------------
# Databricks experiment path
# -----------------------------------------------------------------------------
# No environment variable is required. The runner creates/reuses one
# experiment per agent under /Shared/<agent_name> (for example,
# /Shared/vacation_planner_agent).


# -----------------------------------------------------------------------------
# OPTIONAL -- quality of life
# -----------------------------------------------------------------------------
# Silences the one-time MLflow "load this skill before tracing" hint that
# prints to stdout/stderr on every run (purely cosmetic, safe to set).
# MLFLOW_DISABLE_AGENT_HINT=1


# -----------------------------------------------------------------------------
# NOT an env var, but related: the Databricks serving endpoint and Unity
# Catalog identity your DATABRICKS_TOKEN authenticates as also needs:
#   - CAN QUERY on the serving endpoint named in config/agents.yaml
#     (endpoint_name: vacation_planner_agent)
#   - USE CATALOG / USE SCHEMA / CREATE TABLE on krishna.agent_eval
#   - CAN USE on the SQL warehouse referenced by DATABRICKS_SQL_WAREHOUSE_ID
# These are workspace permissions, not environment variables -- see
# docs/RUNBOOK.md "Prerequisites" for the full checklist.
# -----------------------------------------------------------------------------
